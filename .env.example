# Copy this to .env (same directory as docker-compose.yml) and fill in real
# values before running `docker compose up`. This is separate from
# server/.env.example, which is for running the server directly without
# Docker.

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
FLAG_PEPPER=replace-with-another-long-random-string
TARGET_ACCESS_SECRET=replace-with-yet-another-long-random-string
ADMIN_PASSWORD=set-a-real-admin-password

# Optional overrides - the defaults in docker-compose.yml work for a
# single-machine lab setup.
CORS_ORIGINS=*
TARGET_SERVER_URL=http://localhost:5001
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
