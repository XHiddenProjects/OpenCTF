{
  "name": "openctf",
  "version": "1.1.0",
  "description": "Desktop client for the lab CTF platform",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --linux --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1"
  },
  "overrides": {
    "electron-winstaller": "^5.4.4"
  },
  "build": {
    "appId": "lab.ctf.client",
    "productName": "OpenCTF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  }
}
