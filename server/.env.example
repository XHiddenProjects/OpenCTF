# Copy this file to .env and fill in real values before running in the lab.
# app.py reads these via os.environ - use python-dotenv or export them in your shell.

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
FLAG_PEPPER=replace-with-another-long-random-string
DATABASE_URL=sqlite:///ctf.db
CORS_ORIGINS=*
ADMIN_PASSWORD=changeme123

# Required for every Code Challenge Editor "Run" action. Points at a
# running Judge0 instance (self-hosted: https://github.com/judge0/judge0#-quick-start,
# or a hosted plan) - see server/judge0_runner.py for supported languages.
# Leave unset and code execution returns a clear configuration error.
# JUDGE0_CE_ENDPOINT=http://localhost:2358
# JUDGE0_CE_AUTH_HEADERS={"X-Auth-Token": "replace-with-a-real-token"}