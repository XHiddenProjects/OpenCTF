# Copy this file to .env and fill in real values before running in the lab.
# app.py reads these via os.environ - use python-dotenv or export them in your shell.

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
FLAG_PEPPER=replace-with-another-long-random-string
DATABASE_URL=sqlite:///ctf.db
CORS_ORIGINS=*
ADMIN_PASSWORD=changeme123

# Code Challenge Editor ("Run" button). By default player code runs on THIS
# machine with the interpreters/compilers you already have installed - no
# internet and no Judge0 needed. See docs/CODE_RUNNER.md for the security model.
# CODE_RUNNER=local
# auto | bwrap | netns | none  (auto picks the strongest available; Linux: install bubblewrap)
# CODE_RUNNER_SANDBOX=auto
# Refuse to run player code unless a strong (bubblewrap) sandbox is active:
# CODE_RUNNER_REQUIRE_SANDBOX=1
# Max simultaneous runs (default 2):
# CODE_RUNNER_MAX_CONCURRENT=2
# Custom toolchain paths if they're not on PATH: OPENCTF_NODE, OPENCTF_PYTHON,
# OPENCTF_PHP, OPENCTF_RUBY, OPENCTF_CC, OPENCTF_CXX, OPENCTF_JAVAC, OPENCTF_JAVA

# Optional alternative: use a Judge0 server (self-hosted on your LAN works offline too).
# CODE_RUNNER=judge0
# JUDGE0_CE_ENDPOINT=http://localhost:2358
# JUDGE0_CE_AUTH_HEADERS={"X-Auth-Token": "replace-with-a-real-token"}
